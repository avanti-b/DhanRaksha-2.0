# ══════════════════════════════════════════════════════════════════
# DhanRaksha 2.0 — configuration template
# Copy to .env and adjust. NEVER commit the real .env.
#   cp .env.example .env
# ══════════════════════════════════════════════════════════════════

# ── Application ───────────────────────────────────────────────────
APP_ENV=development
FLASK_DEBUG=false
HOST=0.0.0.0
PORT=5000

# Used by Flask for session signing. Generate your own for any shared
# deployment:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-before-deploying

# ── Storage ───────────────────────────────────────────────────────
# Milestone 1 uses a local SQLite file. Milestone 2 replaces this with
# Cosmos DB settings; the repository layer is the only thing that changes.
DATABASE_PATH=data/dhanraksha.db

# ── ML artifacts ──────────────────────────────────────────────────
ARTIFACT_DIR=ml/artifacts
DATASET_PATH=data/creditcard.csv

# ── Decision thresholds ───────────────────────────────────────────
# Probability at or above which a transaction is called fraud.
# 0.5 is a starting point, not an optimum — see the threshold analysis
# in docs/ml-pipeline.md before changing it.
FRAUD_THRESHOLD=0.5

# Risk Engine banding. Risk score = model probability + rule contribution.
RISK_HIGH_THRESHOLD=0.70
RISK_MEDIUM_THRESHOLD=0.40

# ── Case management ───────────────────────────────────────────────
AUTO_CREATE_CASES=true

# ── API ───────────────────────────────────────────────────────────
CORS_ORIGINS=*
MAX_PAGE_SIZE=200

# ── Training ──────────────────────────────────────────────────────
# -1 uses every core. Set to 1 on memory-constrained machines.
TRAIN_N_JOBS=-1

# ══════════════════════════════════════════════════════════════════
# MILESTONE 2 (Azure) — placeholders only. Not used yet, and no Azure
# resource has been created. Secrets will come from Key Vault, never
# from this file in a real deployment.
# ══════════════════════════════════════════════════════════════════
# COSMOS_ENDPOINT=
# COSMOS_DATABASE=dhanraksha
# AZURE_STORAGE_ACCOUNT=
# AZURE_KEY_VAULT_URI=
# APPLICATIONINSIGHTS_CONNECTION_STRING=
