# ══════════════════════════════════════════════════════════════════════════
# DhanRaksha 2.0 — configuration template
#
#   cp .env.example .env
#
# NEVER commit .env. It is in .gitignore. Never paste a real secret into a
# chat, an issue, or a README.
#
# This file has two halves:
#   PART A — LOCAL DEVELOPMENT   works with zero Azure setup
#   PART B — AZURE DEPLOYMENT    every value you must supply yourself
#
# On Azure, PART B values do NOT go in a .env file. They go into
# App Service -> Settings -> Environment variables -> App settings,
# and the secret ones go into Key Vault. See docs/azure-deployment.md.
# ══════════════════════════════════════════════════════════════════════════


# ══════════════════════════════════════════════════════════════════════════
# PART A — LOCAL DEVELOPMENT
# Copy this file, change nothing, and the app runs on SQLite with no Azure.
# ══════════════════════════════════════════════════════════════════════════

APP_ENV=development
FLASK_DEBUG=false
HOST=0.0.0.0
PORT=5000

# Generate your own before any shared deployment:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-before-deploying

# --- Storage backend -------------------------------------------------------
# "sqlite" locally, "cosmos" on Azure. This single switch selects the
# repository implementation. Nothing else changes.
STORAGE_BACKEND=sqlite
DATABASE_PATH=data/dhanraksha.db

# --- ML artifacts ----------------------------------------------------------
ARTIFACT_DIR=ml/artifacts
DATASET_PATH=data/creditcard.csv

# --- Decision thresholds ---------------------------------------------------
# 0.5 is a starting point, not an optimum. F1 actually peaks at 0.40 on the
# test set — see the threshold analysis in docs/ml-pipeline.md.
FRAUD_THRESHOLD=0.5
RISK_HIGH_THRESHOLD=0.70
RISK_MEDIUM_THRESHOLD=0.40

# --- Case management -------------------------------------------------------
AUTO_CREATE_CASES=true

# --- API -------------------------------------------------------------------
CORS_ORIGINS=*
MAX_PAGE_SIZE=200

# --- Authentication --------------------------------------------------------
# OFF locally: no tenant needed, every endpoint reachable, tests run clean.
AUTH_ENABLED=false

# --- Training --------------------------------------------------------------
TRAIN_N_JOBS=-1


# ══════════════════════════════════════════════════════════════════════════
# PART B — AZURE DEPLOYMENT
#
# Leave every value below EMPTY for local development. Each one is listed in
# the "WHAT I NEED TO CONFIGURE MANUALLY" table in README.md with the exact
# portal path to find it.
# ══════════════════════════════════════════════════════════════════════════

# ── B1. COSMOS DB ─────────────────────────────────────────────────────────
# Set STORAGE_BACKEND=cosmos on Azure to activate these.
#
# COSMOS_ENDPOINT
#   Portal -> Azure Cosmos DB -> <your account> -> Overview -> URI
#   Example: https://cosmos-dhanraksha-a1b2c3.documents.azure.com:443/
COSMOS_ENDPOINT=
#
# COSMOS_KEY  ** SECRET — prefer Key Vault over an App Setting **
#   Portal -> Azure Cosmos DB -> <account> -> Settings -> Keys -> PRIMARY KEY
COSMOS_KEY=
#
COSMOS_DATABASE=dhanraksha
COSMOS_TRANSACTIONS_CONTAINER=transactions
COSMOS_CASES_CONTAINER=cases

# ── B2. BLOB STORAGE + QUEUE ──────────────────────────────────────────────
# STORAGE_CONNECTION_STRING  ** SECRET — prefer Key Vault **
#   Portal -> Storage accounts -> <account> -> Security + networking
#           -> Access keys -> key1 -> Connection string -> Show
#   Example: DefaultEndpointsProtocol=https;AccountName=stdhanrakshaxxx;AccountKey=...;EndpointSuffix=core.windows.net
STORAGE_CONNECTION_STRING=
#
BLOB_ARTIFACTS_CONTAINER=model-artifacts
BLOB_REPORTS_CONTAINER=reports
#
# Set true to download the model from Blob at startup instead of using the
# copy baked into the deployment. Lets you publish a retrained model without
# redeploying the app.
LOAD_ARTIFACTS_FROM_BLOB=false

# ── B3. ASYNC PROCESSING (Azure Functions) ────────────────────────────────
# Needs STORAGE_CONNECTION_STRING above; the queue lives in the same account.
ASYNC_PROCESSING_ENABLED=false
ASYNC_QUEUE_NAME=transaction-queue

# ── B4. KEY VAULT ─────────────────────────────────────────────────────────
# When set, secrets are read from Key Vault FIRST and the plain values above
# become unnecessary. The App Service authenticates with its managed identity,
# so no credential is stored anywhere.
#
# KEY_VAULT_URL
#   Portal -> Key vaults -> <your vault> -> Overview -> Vault URI
#   Example: https://kv-dhanraksha-a1b2c3.vault.azure.net/
#
# Secret names the app looks for (create these in the vault):
#   cosmos-key
#   storage-connection-string
#   secret-key
#   applicationinsights-connection-string
KEY_VAULT_URL=

# ── B5. MICROSOFT ENTRA ID ────────────────────────────────────────────────
# AUTH_ENABLED=true turns on token validation and role checks.
#
# ENTRA_TENANT_ID
#   Portal -> Microsoft Entra ID -> Overview -> Tenant ID
#   Example: 72f988bf-1111-2222-3333-2d7cd011db47
ENTRA_TENANT_ID=
#
# ENTRA_CLIENT_ID
#   Portal -> Microsoft Entra ID -> App registrations -> <your app>
#           -> Overview -> Application (client) ID
#   Example: 4a1b2c3d-5555-6666-7777-9f8e7d6c5b4a
ENTRA_CLIENT_ID=
#
# ENTRA_AUDIENCE
#   Usually the same as ENTRA_CLIENT_ID, or the Application ID URI
#   (Portal -> App registrations -> <app> -> Expose an API).
#   Leave empty to default to ENTRA_CLIENT_ID.
ENTRA_AUDIENCE=
#
# NOTE: the API only VALIDATES tokens, it never issues them, so no client
# secret is required here. Do not put one in this file.

# ── B6. APPLICATION INSIGHTS ──────────────────────────────────────────────
# APPLICATIONINSIGHTS_CONNECTION_STRING  ** SECRET-ish — prefer Key Vault **
#   Portal -> Application Insights -> <your resource> -> Overview
#           -> Connection String
#   Example: InstrumentationKey=00000000-1111-2222-3333-444444444444;IngestionEndpoint=https://centralindia-0.in.applicationinsights.azure.com/
APPLICATIONINSIGHTS_CONNECTION_STRING=
#
# Fraction of telemetry sent (0.0–1.0). Lower it if you ever load-test, to
# protect the 5 GB/month free ingestion allowance.
TELEMETRY_SAMPLE_RATE=1.0


# ══════════════════════════════════════════════════════════════════════════
# EXAMPLE: what PART B looks like when deployed
# (illustrative values — none of these are real)
# ══════════════════════════════════════════════════════════════════════════
# APP_ENV=production
# STORAGE_BACKEND=cosmos
# COSMOS_ENDPOINT=https://cosmos-dhanraksha-a1b2c3.documents.azure.com:443/
# KEY_VAULT_URL=https://kv-dhanraksha-a1b2c3.vault.azure.net/
# LOAD_ARTIFACTS_FROM_BLOB=true
# ASYNC_PROCESSING_ENABLED=true
# AUTH_ENABLED=true
# ENTRA_TENANT_ID=72f988bf-1111-2222-3333-2d7cd011db47
# ENTRA_CLIENT_ID=4a1b2c3d-5555-6666-7777-9f8e7d6c5b4a
# CORS_ORIGINS=https://dhanraksha-a1b2c3.azurewebsites.net
#
# With KEY_VAULT_URL set, COSMOS_KEY / STORAGE_CONNECTION_STRING /
# APPLICATIONINSIGHTS_CONNECTION_STRING are read from the vault and do not
# appear as App Settings at all.
